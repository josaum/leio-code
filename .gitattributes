# Ensure shell scripts and source files keep LF line endings on Windows checkouts
*.sh text eol=lf
*.bash text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Makefile* text eol=lf
Dockerfile* text eol=lf
