# Copy to `.env.local` for local Keycloak + oauth-jwt (see README § Keycloak Quickstart).
# Prerequisite: `cd keycloak && docker compose up -d` (realm imports on boot).

LEIO_APPS_SDK_AUTH_MODE=oauth-jwt
LEIO_APPS_SDK_JWT_ISSUER=http://localhost:8080/realms/leio-code
LEIO_APPS_SDK_JWT_AUDIENCE=leio-code-apps-sdk
LEIO_APPS_SDK_TENANT_CLAIM=tenant_id
LEIO_APPS_SDK_TENANT_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Optional override; otherwise derived from the issuer via OIDC discovery.
# LEIO_APPS_SDK_JWKS_URL=http://localhost:8080/realms/leio-code/protocol/openid-connect/certs

LEIO_APPS_SDK_PUBLIC_URL=http://127.0.0.1:3333

# Optional helper values consumed by `npm run keycloak:create-dev-user`.
LEIO_KEYCLOAK_DEV_TENANT_ID=public-demo
