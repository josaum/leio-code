LEIO_APPS_SDK_HOST=127.0.0.1
LEIO_APPS_SDK_PORT=3333
LEIO_CODE_TIMEOUT_MS=120000
LEIO_CODE_INDEX_TIMEOUT_MS=300000

# Where session-scoped repo checkouts are cloned and refreshed.
LEIO_CODE_CHECKOUTS_ROOT=/tmp/leio-code-checkouts
# Comma-separated allowed hosts for repo_url clone flows. Use "*" only for a
# trusted internal deployment that intentionally accepts arbitrary HTTPS remotes.
LEIO_CODE_ALLOWED_REPO_HOSTS=github.com,gitlab.com
# Optional local-dev escape hatch for repo_url values like http://localhost/org/repo.git.
LEIO_CODE_ALLOW_INSECURE_LOCAL_REPO_URLS=false
# Hosted (non-loopback) deployments reject caller-supplied absolute server paths.
# Loopback binds (127.0.0.1 / localhost / ::1) accept repo_root by default.
# Set false to force hosted-style rejection even on localhost. Set true on a
# trusted non-loopback ops bind that should accept server paths.
LEIO_APPS_SDK_ALLOW_SERVER_REPO_ROOT=

# Canonical public HTTPS base URL for the deployed app, used for resource metadata.
# Example: https://leio-code.getjai.com
LEIO_APPS_SDK_PUBLIC_URL=

# Extra Host header allowlist entries when binding 0.0.0.0 (comma-separated).
# Public hostname from LEIO_APPS_SDK_PUBLIC_URL is included automatically.
LEIO_APPS_SDK_ALLOWED_HOSTS=

# Extra browser Origins allowed for OPTIONS/CORS on /mcp (comma-separated).
# Defaults always include https://chatgpt.com, https://chat.openai.com,
# https://platform.openai.com.
LEIO_APPS_SDK_CORS_ORIGINS=

# Public-facing metadata for legal/support pages.
LEIO_APPS_SDK_PUBLISHER_NAME=
LEIO_APPS_SDK_COMPANY_NAME=
LEIO_APPS_SDK_COMPANY_URL=
LEIO_APPS_SDK_SUPPORT_URL=
LEIO_APPS_SDK_PRIVACY_URL=
LEIO_APPS_SDK_TERMS_URL=
LEIO_APPS_SDK_SUPPORT_EMAIL=
LEIO_APPS_SDK_PRIVACY_EMAIL=
LEIO_APPS_SDK_SECURITY_EMAIL=
LEIO_APPS_SDK_SUPPORT_HOURS=
LEIO_APPS_SDK_LEGAL_LAST_UPDATED=

# Auth modes:
# - none: anonymous read-only access
# - static-bearer: direct clients can send Bearer tokens; no ChatGPT OAuth linking UI
# - oauth-jwt: ChatGPT-compatible OAuth resource server with JWT validation
LEIO_APPS_SDK_AUTH_MODE=none

# Space- or comma-separated scopes required by authenticated tools.
LEIO_APPS_SDK_AUTH_SCOPES=repo.read

# Comma-separated Apps SDK tool names that require authentication when auth is enabled.
# Keep search_repository_memory protected so tenant-scoped semantic retrieval
# is available only after the caller has authenticated.
LEIO_APPS_SDK_PROTECTED_TOOLS=explain_repository,search_repository_memory,audit_repository_contracts,audit_repository_rollup

# Optional domain specialist (Carlos Motta / VIGOROS). Tool is registered only when
# LEIO_VIGOROS_MCP_URL is set — leave unset for a generic Apps SDK posture.

# Optional stricter mode: require auth on the /mcp connection itself.
LEIO_APPS_SDK_REQUIRE_AUTH_ON_CONNECT=false

# Optional display metadata for the OAuth protected resource document.
LEIO_APPS_SDK_RESOURCE_NAME=LEIO Code
LEIO_APPS_SDK_RESOURCE_DOCUMENTATION_URL=

# static-bearer mode
LEIO_APPS_SDK_STATIC_BEARER_TOKENS=
# Stable tenant identity for a single-tenant static-bearer deployment. OAuth
# deployments ignore this and derive tenant scope from the verified JWT.
LEIO_APPS_SDK_STATIC_TENANT_ID=static-bearer

# oauth-jwt mode
LEIO_APPS_SDK_AUTHORIZATION_SERVERS=
LEIO_APPS_SDK_JWT_ISSUER=
LEIO_APPS_SDK_JWT_AUDIENCE=
# Optional: explicit OIDC discovery URL. If absent, the runtime derives the
# standard discovery URL from LEIO_APPS_SDK_JWT_ISSUER.
LEIO_APPS_SDK_OIDC_DISCOVERY_URL=
LEIO_APPS_SDK_JWKS_URL=
LEIO_APPS_SDK_JWT_RESOURCE_CLAIM=resource
# Trusted OIDC claim used for organization-level tenant isolation. When absent,
# the authenticated issuer+subject pair becomes a personal tenant.
LEIO_APPS_SDK_TENANT_CLAIM=tenant_id
# Required for authenticated tenant scoping. Generate at least 32 random
# bytes; never commit the value. It HMACs tenant/repository identifiers so
# raw identities never enter node-store primary keys.
LEIO_APPS_SDK_TENANT_HMAC_SECRET=

# Optional stricter scopes for the audit tool.
LEIO_APPS_SDK_AUDIT_SCOPES=

# Optional generic Git auth for fixed-repo or repo_url clone flows.
LEIO_CODE_GIT_HTTP_USERNAME=
LEIO_CODE_GIT_HTTP_PASSWORD=
LEIO_CODE_GIT_AUTH_TOKEN=
LEIO_CODE_GITHUB_TOKEN=
LEIO_CODE_GITLAB_TOKEN=

# Optional GitHub App source connector for private repositories.
# This is separate from Keycloak/OIDC, which authenticates the ChatGPT app itself.
LEIO_CODE_GITHUB_APP_SLUG=
LEIO_CODE_GITHUB_APP_ID=
LEIO_CODE_GITHUB_APP_CLIENT_ID=
LEIO_CODE_GITHUB_APP_CLIENT_SECRET=
LEIO_CODE_GITHUB_APP_PRIVATE_KEY=
LEIO_CODE_GITHUB_APP_CALLBACK_URL=

# Optional bridge to the Carlos Motta / VIGOROS digital twin.
# When configured, the LEIO Code ChatGPT app can dispatch repository context to VIGOROS.
LEIO_VIGOROS_PUBLIC_URL=https://carlos-motta-apps-sdk.fly.dev
LEIO_VIGOROS_MCP_URL=
LEIO_VIGOROS_JWT_ISSUER=
LEIO_VIGOROS_TOKEN_URL=
LEIO_VIGOROS_CLIENT_ID=
LEIO_VIGOROS_CLIENT_SECRET=
# Optional; leave empty unless your authorization server requires explicit scopes
# on the client_credentials exchange.
LEIO_VIGOROS_SCOPES=
